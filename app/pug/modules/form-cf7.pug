block form 
  form.form#formHomeReg.animated-page-content(action="/") 
    label.form__label(for="name")
      input.form__input(type="text" id="name" name="name" value="" placeholder="Your name" required)
      .validate-block
        span *Required field                            
    label.form__label(for="email")
      input.form__input(type="email" id="email" name="email" value="" placeholder="E-mail" required)
      .validate-block
        span *Required field                          
    label.form__label(for="country")
      //- input.form__input(type="text" id="country" name="country" value="" placeholder="Country" required)
      select#country(name='country')
      .validate-block
        span *Required field                            
    label.form__label(for="phone")
      input.form__input(type="tel" id="phone" name="phone" value="" required)
      .validate-block
        span *Required field                            
    label.form__label(for="social-din")
      input.form__input.form__input--invalid(type="text" id="social-din" name="social-din" value="" placeholder="Telegram")
      .validate-block
        span *Required field
    input#currentCountry(type="hidden" name="currentCountry" value="ua")
    input#regTag(type="hidden" name="tag" value="<?= $form_tag ?>")
    input(type="hidden" name="visitorId" id="visitorId" value="")
    input(type="hidden" name="visitorIp" id="visitorIp" value="")
    a#authLink(style='position:absolute; opacity: 0; z-index: -100; height: 0px; width: 0px;' href='#')
    //- select.form-element(name="currency" id="currency")

    //- label.form__label(for="textarea")
    //-   textarea#textarea(name="textarea", rows="6" placeholder="Hello...")
    //- label(class="form__label" for="checkbox")
    //-   span(class="wpcf7-form-control-wrap" data-name="checkbox")
    //-     span(class="wpcf7-form-control wpcf7-acceptance")
    //-       span(class="wpcf7-list-item")
    //-         input(class="visually-hidden"  type="checkbox" name="checkbox" value="1" aria-invalid="false"  id="checkbox")
    //-   span(class="check-box")
    //-   span(class="checklabel") I agree to the processing of personal data
    .form__actions
      button.button.button--submit.sub-form(type="submit") Submit
    .wpcf7-response-output(style="display: block;") The application has been successfully submitted!
  