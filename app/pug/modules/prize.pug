section#prize.prize
  .prize__decor-glow-left
  .prize__decor-glow-right
  .container 
    .prize__inner
      h2.prize__title.title Prize Pool Distribution
      p.prize__subtitle The hunt is on! 
      p.prize__subtitle Help your players deposit more = win more. $1,600 prize pool awaits.
      
      ul.prize__list
        li.prize__card.prize__card--1
            .prize__image
                picture     
                    source(type="image/avif" srcset="./images/prize/CU Coins 1.avif")
                    source(type="image/webp" srcset="./images/prize/CU Coins 1.webp")
                    img(src="./images/prize/CU Coins 1.png", alt="coin")
            h3 1st Place - $1,000 
            p For player deposits totaling $10,000+
            //- <svg viewBox="0 0 284 2" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            //-     <path d="M0 1H284"></path>
            //- </svg>            
            
        li.prize__card.prize__card--2
            .prize__image
                picture     
                    source(type="image/avif" srcset="./images/prize/CU Coins 1.avif")
                    source(type="image/webp" srcset="./images/prize/CU Coins 1.webp")
                    img(src="./images/prize/CU Coins 1.png", alt="coin")
            h3 2nd Place - $500
            p For player deposits totaling $9,000 - $9,999
            //- <svg viewBox="0 0 284 2" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            //-     <path d="M0 1H284"></path>
            //- </svg>            
            
        li.prize__card.prize__card--3                 
            .prize__image
                picture     
                    source(type="image/avif" srcset="./images/prize/CU Coins 1.avif")
                    source(type="image/webp" srcset="./images/prize/CU Coins 1.webp")
                    img(src="./images/prize/CU Coins 1.png", alt="coin")
            h3 3rd Place - $100
            p For player deposits totaling $8,000-$8,999
