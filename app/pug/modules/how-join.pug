section#how-join.how-join
    .container 
        .how-join__inner
            .how-join__text
                p.font Your path to online earnings starts here with BETANDYOU Mobcash! Become an agent, manage player transactions, or build your own network. With fast payouts, powerful tools, and expert support, growing your income across Africa has never been easier. Are you ready to start?
                h2.how-join__title.title How to Join? 
            .how-join__slide.swiper.how-join-swiper
                .swiper-wrapper 
                    
                        article.how-join__card.how-join__card--1.swiper-slide
                            h3 Register or log in to your agent account   
                            .how-join__image
                                picture
                                    source(type="image/avif" srcset="./images/num/n1.avif")
                                    source(type="image/webp" srcset="./images/num/n1.webp")    
                                    img(src="./images/num/n1.png" alt="diamond" width="150" height="180")
                            //- include ../icons-steps/step-1 
                    
                        article.how-join__card.how-join__card--2.swiper-slide
                            h3 Invite players and help them make deposits from 3 to 16 Nov 
                            .how-join__image
                                picture
                                    source(type="image/avif" srcset="./images/num/n2.avif")
                                    source(type="image/webp" srcset="./images/num/n2.webp")    
                                    img(src="./images/num/n2.png" alt="diamond" width="150" height="180")                               
                            //- include ../icons-steps/step-2 
                    
                        article.how-join__card.how-join__card--3.swiper-slide                 
                            h3 The more your players deposit, the higher your position on the leaderboard! 
                            .how-join__image
                                picture
                                    source(type="image/avif" srcset="./images/num/n3.avif")
                                    source(type="image/webp" srcset="./images/num/n3.webp")    
                                    img(src="./images/num/n3.png" alt="diamond" width="150" height="180")
                            //- include ../icons-steps/step-3
                .swiper-navigation-block
                    .swiper-pagination        
                                      
                            //- include ../icons-steps/step-6
