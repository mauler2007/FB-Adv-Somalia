    include footer-sprite
    <div class="promo-popup" id="promoPopup">
        <div class="promo-popup__overlay"></div>

        <div class="promo-popup__content">
            <div class="promo-popup__close" >
                <button  id="popupClose">×</button>
            </div>

            <div class="promo-popup__text">
                <h3>GANHE 2% A MAIS NA SUA COMISSÃO POR 6 MESES</h3>
                <p>Restam apenas 5 vagas corra e seja o primeiro a participar!</p>
            </div>

            <div class="promo-popup__img">
                picture
                    source(type="image/avif" media="(min-width: 1200px)" srcset="./images/uz/popup/deposit-img.avif?v=2")
                    source(type="image/webp" media="(min-width: 1200px)" srcset="./images/uz/popup/deposit-img.webp?v=2")                               
                    source(type="image/avif" srcset="./images/uz/popup/deposit-img-mob@2x.avif?v=2")
                    source(type="image/webp" srcset="./images/uz/popup/deposit-img-mob@2x.webp?v=2")                               
                    img(src="./images/uz/popup/deposit-img-mob@2x.png?v=2" alt="valyuta" width="194" height="130")
            </div>
        </div>
    </div>