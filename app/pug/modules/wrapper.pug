mixin instruction(modificator)
    section.instruction(class=`instruction--${modificator}`)
        .instruction__inner
            .instruction__items 
                #instructionNumberOne.instruction__number
                    .instruction__content
                        span.instruction__num(data-text="1") 1
                        .instruction__box
                            .instruction__action register on the site
                            //- span  
                            //- span 
                .instruction__separator
                #instructionNumberTwo.instruction__number
                    .instruction__content.instruction__content--custom
                        //- span
                        span.instruction__num(data-text="1") 2
                        .instruction__box               
                            p.instruction__action make a deposit
                        //-   span
                        //- span
                .instruction__separator
                #instructionNumberThree.instruction__number
                    .instruction__content
                        span.instruction__num(data-text="1") 3
                        .instruction__box
                            p.instruction__action WIN with B&U
                            //- span
block wrapper 
    .wrapper(style="opacity: 1;")
        include header
        main.main
           
